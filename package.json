{
  "name": "zebra-puzzle-solver",
  "version": "0.0.1",
  "main": "dist/index.js",
  "description": "This is an exercise in programming complex logic. Although primarily intended for entertainment, it provides solid examples of best practices for solving problems with code.",
  "homepage": "https://github.com/dalealleshouse/zebra-puzzle-solver#readme",
  "bugs": {
    "url": "https://github.com/dalealleshouse/zebra-puzzle-solver/issues"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "release": {
    "branches": [
      "master"
    ],
    "extends": "@semantic-release/gitlab-config"
  },
  "directories": {
    "src": "src"
  },
  "scripts": {
    "build": "npx tsc",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npx jest --coverage --testPathPattern=src/__test__/unit --colors --coverageDirectory 'coverage/unit' --verbose --detectOpenHandles --runInBand",
    "test:integration": "npx jest --coverage --testPathPattern=src/__test__/integration --colors --coverageDirectory 'coverage/integration' --runInBand",
    "test:watch": "npx jest --testPathPattern=src/__test__/unit --colors --verbose --detectOpenHandles --runInBand --watch",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "author": "Dale Alleshouse",
  "license": "ISC",
  "dependencies": {},
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__test__/**"
    ]
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/jest": "^29.5.14",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^52.0.4",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}
